{
  "name": "nodejs-apis",
  "version": "1.0.0",
  "description": "Nodejs api for serveral IT sectors",
  "license": "MIT",
  "author": "Leonardo Bravo",
  "type": "module",
  "private": "true",
  "scripts": {
    "prepare": "husky",
    "start:fintech": "cd fintech-api && docker-compose up",
    "stop:fintech": "cd fintech-api && docker-compose down",
    "restart:fintech": "cd fintech-api && docker-compose restart",
    "build:fintech": "cd fintech-api && docker-compose build",
    "logs:fintech": "cd fintech-api && docker-compose logs -f"
  },
  "devDependencies": {
    "@commitlint/cli": "20.4.1",
    "@commitlint/config-conventional": "20.4.1",
    "husky": "9.1.7"
  }
}
